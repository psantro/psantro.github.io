{
  "name": "psantro-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "build": "ng build --configuration production && node scripts/write-root-redirect.mjs",
    "extract-i18n": "ng extract-i18n --format=xlf2 --output-path=src/locale --out-file=messages.xlf",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
